{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Regio",
  "version": "0.2.0",
  "identifier": "org.regio.app",
  "build": {
    "beforeDevCommand": "npm run dev:tauri",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Regio",
        "width": 1366,
        "height": 820,
        "minWidth": 1100,
        "minHeight": 680,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,OverscrollHistoryNavigation --disable-pinch --overscroll-history-navigation=0"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0QTM0NDQ2MUZBMTM1RDQKUldUVU5hRWZSa1NqaEQ1T2NKaFdmd2FmNnRvM1k0VTNXbVdsZi9lVmRoZW56bTVkcm9BbUh4YXIK",
      "endpoints": [
        "https://github.com/ngangoula-jaures/Regio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
